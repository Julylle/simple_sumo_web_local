MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sumo_timeseries
MYSQL_USER=sumo
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_password
KEPSERVER_OPC_URL=opc.tcp://127.0.0.1:49320
KEPSERVER_NAMESPACE_INDEX=2
# Prefer a namespace URI if the server's namespace index can change.
# KEPSERVER_NAMESPACE_URI=KEPServerEX
RAW_SAMPLE_SECONDS=60
SUMO_MYSQL_ENABLED=1
# 0 = all StateVariable/AccumulatedStateVariable entries plus dashboard outputs.
# 1 = also record every SystemState entry (about 152,000 extra entries in this model).
SUMO_DB_INCLUDE_SYSTEM_STATE=0
